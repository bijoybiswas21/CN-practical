
#include <iostream>
using namespace std;

class Person {
public:
    string name;
    int age;

    void input1() {
        cout << "Enter Name: ";
        cin >> name;
        cout << "Enter Age: ";
        cin >> age;
    }
};

class Academic {
public:
    int marks;

    void input2() {
        cout << "Enter Marks: ";
        cin >> marks;
    }
};

class Student : public Person, public Academic {
public:
    int roll;

    void input3() {
        cout << "Enter Roll No: ";
        cin >> roll;
    }

    void display() {
        cout << "\n--- Student Details ---" << endl;
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "Roll No: " << roll << endl;
        cout << "Marks: " << marks << endl;
    }
};

int main() {
    Student s;

    s.input1();
    s.input2();
    s.input3();
    s.display();

    return 0;
}
