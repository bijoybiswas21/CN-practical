#include <iostream>
using namespace std;
class Employee
{
    private:
    string Empname;
    int Empid;
    int EmpSalary;

    public:
    Employee (string n, int i, float s)
    {
        Empname=n;
        Empid=i;
        EmpSalary=s;
    }

    public:
    void display()
    {
        cout << "The Name Of The Employee Is: " << Empname << endl;
        cout << "The ID number of the Employee is: " << Empid << endl;
        cout << "The Salary of the Employee is: "<< EmpSalary << endl;
    }
};
int main ()
{
    string Empname;
    int Empid;
    float EmpSalary;
    cout << "Enter the name of the Employee: "<< endl;
    cin >> Empname;
    cout << "Enter the ID number of the Employee: " << endl;
    cin >> Empid;
    cout << "Enter the Salary of the Employee: "<< endl;
    cin >> EmpSalary;
    Employee e1(Empname,Empid,EmpSalary);
    e1.display();
    return 0;
}