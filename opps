#include <iostream>
using namespace std;

class Student {
private:
    string name;
    int age;
    int marks;

public:
    void setData(string n, int a, int m) {
        name = n;
        age = a;
        marks = m;
    }

    void display() {
        cout << "Name: " << name << endl;
        cout << "Age: " << age << endl;
        cout << "Marks: " << marks << endl;
        cout << "------------------" << endl;
    }
};

int main() {
    Student s[3];

    // Input using loop
    for (int i = 0; i < 3; i++) {
        string name;
        int age, marks;

        cout << "Enter details of Student " << i + 1 << endl;

        cout << "Name: ";
        cin >> name;

        cout << "Age: ";
        cin >> age;

        cout << "Marks: ";
        cin >> marks;

        s[i].setData(name, age, marks);
    }

    // Display using loop
    cout << "\nStudent Details\n";

    for (int i = 0; i < 3; i++) {
        s[i].display();
    }

    return 0;
}