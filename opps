#include <iostream>
using namespace std;

class Employee {
public:
    void display(string name, int id, double salary) {
        cout << "\n--- Employee Information ---" << endl;
        cout << "Name: " << name << endl;
        cout << "ID: " << id << endl;
        cout << "Salary: " << salary << endl;
    }
};

int main() {
    Employee e;

    string name;
    int id;
    double salary;

    cout << "Enter Employee Name: ";
    cin >> name;

    cout << "Enter Employee ID: ";
    cin >> id;

    cout << "Enter Salary: ";
    cin >> salary;

    e.display(name, id, salary);

    return 0;
}